# Claude writes Reachy's lines in the participant's language. Without a key Reachy
# falls back to offline English templates (the session still runs end to end).
ANTHROPIC_API_KEY=

# Any Config field (src/beating_in_sync_app/config.py) can be overridden as BIS_<FIELD>.

# Arduino Nano serial port. Leave unset to auto-detect: only free ports that actually
# stream "ir1,ir2" lines are used; the Reachy Mini daemon's port is never opened.
# BIS_HEART_PORT=/dev/cu.usbserial-XXXX

# How the two pulse sensors are used: one (a finger on either sensor: snoring, then wake),
# wake (sensor 1 baseline, pressing sensor 2 wakes Reachy), two (sensor 2 is a second person).
# BIS_PULSE_MODE=one

# IR level that counts as a finger on the sensor (pulse_triple.py --finger-min).
# BIS_FINGER_MIN=20000

# Thresholds to tune in pilot sessions (Personality doc).
# BIS_BPM_JUMP_THRESHOLD=15
# BIS_LOOK_AWAY_S=3
# BIS_BPM_STOP_LIMIT=130

# Claude model and effort for live speech (low effort keeps latency down).
# BIS_LLM_MODEL=claude-opus-5-5
# BIS_LLM_EFFORT=low

# Camera index for face emotion / attention, and the FER/TER model files from
# kudosscience/fer_and_ter_model.
# BIS_CAMERA_INDEX=0
# BIS_FER_MODEL_PATH=models/fer2013_final_model.pth
# BIS_TER_MODEL_DIR=models/ter_distilbert_model

# Recorded emotions from the Pollen HF dataset (downloaded on first use).
# BIS_USE_EMOTION_LIBRARY=true

# Folder with one song per language for stage 5: assets/music/<lang>.mp3 (+ default.mp3).
# BIS_MUSIC_DIR=assets/music

# Where session logs go.
# BIS_SESSIONS_DIR=sessions
